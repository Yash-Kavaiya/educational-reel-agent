GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
SARVAM_API_KEY=

# Vercel AI Gateway (LiteLLM). Either name works.
VERCEL_AI_GATEWAY_API_KEY=
AI_GATEWAY_API_KEY=

# Agent LLM (free): InclusionAI Ling 3.0 Flash Fin via LiteLLM
ADK_MODEL=inclusionai/ling-3.0-flash-fin-free
# Evaluation model: TypeSafe Jev
JEV_MODEL=typesafe-ai/jev
ADK_APP_NAME=educational-reel-agent

PORT=8080
HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=*

OUTPUT_DIR=output
STORYBOARDS_DIR=storyboards
LOGS_DIR=logs

REELGEN_PYTHON=
REELGEN_MODULE=reelgen
RENDER_TIMEOUT_SECONDS=600

YOUTUBE_CREDENTIALS_FILE=
YOUTUBE_TOKEN_FILE=

DEFAULT_SERIES_TITLE=Oracle AI Agents
DEFAULT_HANDLE=@genai_guru
DEFAULT_THEME=oracle
DEFAULT_VOICE=anushka
